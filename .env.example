# Library
LIBRARY_ROOT=/games

# Persistence
CACHE_DIR=/data/cache
DB_PATH=/data/kr8bit.db
DATABASE_URL=file:/data/kr8bit.db

# HTTP
PORT=8080
HOST=0.0.0.0

# Logging
LOG_LEVEL=info

# IGDB (optional second metadata provider; omit to disable)
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# IGDB_API_BASE=https://api.igdb.com/v4
# IGDB_TOKEN_BASE=https://id.twitch.tv/oauth2
# IGDB_HTTP_TIMEOUT_MS=15000

# Steam App Index (optional — speeds up search with a local app list)
# Without this, search uses live Steam storesearch (slightly slower but works fine)
# Get a key at https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# SteamGridDB Artwork (optional — replaces default Steam artwork with community grids)
# Without this, games use Steam CDN cover/header images
# Get a key at https://www.steamgriddb.com/profile/preferences/api
# STEAMGRIDDB_API_KEY=
# STEAMGRIDDB_API_BASE=https://www.steamgriddb.com/api/v2
# STEAMGRIDDB_HTTP_TIMEOUT_MS=15000

# Artwork HTTP client timeouts (optional)
# ARTWORK_HTTP_HEADER_TIMEOUT_MS=15000
# ARTWORK_HTTP_BODY_TIMEOUT_MS=30000
# ARTWORK_CACHE_TTL_MS=2592000000

# Steam HTTP client timeout (optional)
# STEAM_HTTP_TIMEOUT_MS=15000

# Metadata Matching (optional)
# MATCH_ACCEPT_THRESHOLD=85
# MATCH_FLAG_THRESHOLD=70

# HTTP Retry (optional)
# HTTP_RETRY_COUNT=3
# HTTP_RETRY_BASE_MS=1000

# Metadata Jobs (optional)
# METADATA_REFRESH_DELAY_MS=500
# METADATA_RETRY_DELAY_MS=500
# METADATA_REFRESH_CONCURRENCY=3
# METADATA_RETRY_CONCURRENCY=3
# METADATA_REFRESH_MIN_AGE_MS=604800000

# Scanner (optional)
# SCAN_MAX_DEPTH=1
# SCAN_EXTENSIONS=.7z
# SCAN_INSTALLER_NAMES=setup.exe